# Copy to .env and fill in. .env is git-ignored. Never share or commit it.
# This project is READ-ONLY on-chain: no wallet, no private key, no trading.

# ---------- MongoDB (main database) ----------
MONGODB_URI=
MONGODB_DB=near_entity_tracker

# ---------- NEAR AI (the AI brain) ----------
# NEAR AI Cloud is OpenAI-compatible: https://cloud-api.near.ai/v1 . Create a key at https://cloud.near.ai (API Keys).
# Without a key the tracker still works, with rule-based verdicts only.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Any chat model from https://cloud-api.near.ai/v1/models that supports JSON output.
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_TIMEOUT_SECONDS=120
# token analysis write-ups (On-chain analysis page): model served by NEAR AI, and a longer timeout
NEAR_AI_ANALYSIS_MODEL=anthropic/claude-sonnet-5-5
NEAR_AI_ANALYSIS_TIMEOUT_SECONDS=600
NEAR_AI_MAX_TOKENS=4000

# ---------- On-chain data (FastNEAR) ----------
FASTNEAR_API_KEY=
# NEAR_RPC_URLS=https://rpc.mainnet.fastnear.com,https://free.rpc.fastnear.com
# FASTNEAR_TX_URL=https://tx.main.fastnear.com
# FASTNEAR_API_URL=https://api.fastnear.com

# ---------- What to track ----------
LAUNCHPADS=nearlytrade,justhoot,memecooking
POLL_SECONDS=20
# "Early" = bought within this many minutes of the pool going live (and among the first ENTRY_MAX_BUYERS buyers).
ENTRY_WINDOW_MINUTES=10
ENTRY_MAX_BUYERS=60
# Ignore dust: an early entry must be at least this many NEAR.
MIN_ENTRY_NEAR=1
# Token outcomes are measured at these ages (minutes). The last one is when a token is considered finished.
OUTCOME_MINUTES=60,360,1440
# Full ledger: after the first 24 h, keep reading each token's trades up to today (current price, all-time high, current ROI of early buyers).
# Verdicts still use OUTCOME_MINUTES. Re-read every ACTIVE hours while it trades, every QUIET hours after QUIET_DAYS without a trade,
# stop after STOP_DAYS without a trade. ROWS_PER_PASS transactions are read per token per pass, TOKENS_PER_CYCLE tokens per worker cycle.
LEDGER_ENABLED=true
LEDGER_ACTIVE_HOURS=6
LEDGER_QUIET_HOURS=24
LEDGER_QUIET_DAYS=2
LEDGER_STOP_DAYS=14
LEDGER_ROWS_PER_PASS=1000
LEDGER_TOKENS_PER_CYCLE=4
# Any sale by the token's creator above this many NEAR makes the token a rug (creator sold), in the first 24 h or later.
CREATOR_SELL_RUG_NEAR=0
# A token is a rug when its price falls this far below its peak within 24 h (0.9 = -90 %).
RUG_DRAWDOWN=0.9
# a fall this deep counts as a rug when the creator also sold 1+ NEAR
SOFT_RUG_DRAWDOWN=0.7
# round trip: pumped to this multiple of the launch price and back at or below this multiple of it = rug
CREATOR_EXIT_SHARE=0.8
ROUND_TRIP_PEAK=3
ROUND_TRIP_BACK=1.25
# A 24 h ROI above this counts as a win for a wallet / group.
WIN_ROI=0.2

# ---------- Funding / flow graph ----------
FUNDING_DEPTH=3
# deep links: hops of funding / flow followed from each early wallet; linked (non-early) wallets profiled per cycle and the cap on how many are stored (0 = off)
DEEP_DEPTH=3
NETWORK_EXPAND_BATCH=20
NETWORK_MAX_NODES=5000
FLOW_LOOKBACK_TXS=60
# Wallets that bought together in at least this many tokens (within COBUY_SECONDS of each other) are linked.
COBUY_MIN_TOKENS=4
COBUY_SECONDS=15
PROFILE_CONCURRENCY=4

# ---------- Scanner mode: monitor every launch, hard gates, AI analyst, SIMULATED investing ----------
SCAN_ENABLED=true
# First check this long after the pool opens (justhoot waits longer: it taxes buys in the first ~2 minutes).
OBSERVE_SECONDS=120
JUSTHOOT_MIN_AGE_SECONDS=240
# A launch that was not checked within this long is skipped as stale.
MAX_TOKEN_AGE_MINUTES=60
# Hard gates (a failed gate = no buy)
MIN_POOL_NEAR=50
MIN_UNIQUE_BUYERS=11
MIN_MCAP_USD=8500
MAX_TAX_BPS=1000
MAX_LINKED_BUYER_SHARE=0.4
# Early buying from groups judged dangerous (insiders, rug farmers, sybil snipers) above this share fails a gate.
MAX_BAD_GROUP_SHARE=0.4
# Gate: how many other token creators tied to this one (funding / payments) may have rugged or be blacklisted; -1 turns the gate off.
CREATOR_NETWORK_MAX_RUGGERS=0
MAX_PRICE_MULTIPLE=8
IGNORE_RUNUP_BELOW_MCAP_USD=10000
MIN_RULE_SCORE=55
# AI analyst (NEAR AI): BUY_MORE at or above this confidence buys; a clean pass with a rule score >= HOLD_BUY_MIN_SCORE also buys when the AI only says HOLD.
AI_MIN_CONFIDENCE=0.65
HOLD_BUY_MIN_SCORE=75
HOLD_BUY_BLOCK_HIGH_RISK=false
# true: nothing is bought without a NEAR AI verdict. false: the gates alone decide when the AI is off / fails.
SIM_REQUIRE_AI=true
# Simulated wallet (paper money; nothing is ever sent to the chain)
SIM_ENABLED=true
SIM_START_NEAR=100
SIM_BUY_NEAR=5
SIM_HIGH_RISK_BUY_NEAR=2
SIM_EXTRA_SLIPPAGE_BPS=100
SIM_MAX_OPEN_COST_NEAR=50
SIM_MAX_BUYS_PER_DAY=10
SIM_MIN_RESERVE_NEAR=3
# Take out the cost plus this share of the profit once ROI passes TAKE_PROFIT_ROI (3 = +300 %), keep the rest.
TAKE_PROFIT_ROI=3
TAKE_PROFIT_PROFIT_SHARE=0.5
POSITION_CHECK_SECONDS=60
# A creator who dumps a token the simulated wallet holds is blacklisted and the position is sold.
SIM_RUG_WATCH=true
# Follow-up reviews: tokens that scored above FOLLOWUP_MIN_SCORE are re-reviewed at these minutes after the pool opened.
# A review (not holding) that fails the gates cancels the later ones; an AI SELL on a held token sells it (simulated).
FOLLOWUP_ENABLED=true
FOLLOWUP_MIN_SCORE=70
FOLLOWUP_MINUTES=15,90,180
FOLLOWUP_CAN_SELL=true

# ---------- Contract audit (access keys, code, tax, sell behaviour of the token contract) ----------
AUDIT_ENABLED=true
# A risk score at or above this (70 = critical), or any confirmed malicious finding, fails the contract_audit_ok gate.
AUDIT_MAX_RISK=70
AUDIT_TIMEOUT_SECONDS=60

# ---------- Group evaluation ----------
MIN_TOKENS_FOR_VERDICT=3
GOOD_SCORE=68
BAD_SCORE=38
# Re-run the AI review of a group at most this often (hours), unless its numbers changed a lot.
REVIEW_EVERY_HOURS=6
# Only review groups with at least this many wallets and tokens.
REVIEW_MIN_WALLETS=2

# ---------- Web UI ----------
# Locally the UI listens on 127.0.0.1:8790. On a host (Railway) it listens on 0.0.0.0:8080 (or PORT).
DASHBOARD_PORT=8790
# DASHBOARD_HOST=127.0.0.1
# Optional: require a password (HTTP Basic auth, any username). Without it a public deployment is read-only (simulated sells disabled).
DASHBOARD_PASSWORD=

# creator exit: share of the dev buy sold within the first hour, and the highest price (x launch price) at which that still counts as a rug
CREATOR_EXIT_SHARE=0.8
CREATOR_EXIT_BACK=1.5
# hide thresholds / rule names / reasons from the API: default on for a public deployment (hosted, no DASHBOARD_PASSWORD); 1 / 0 forces it
# HIDE_CRITERIA=1
