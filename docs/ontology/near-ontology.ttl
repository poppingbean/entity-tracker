<https://app.safe-near.org/ns/source/manual> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """manual"""@en ; <https://app.safe-near.org/ns/rank> "7"^^xsd:integer .
<https://app.safe-near.org/ns/source/public_report> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """public_report"""@en ; <https://app.safe-near.org/ns/rank> "6"^^xsd:integer .
<https://app.safe-near.org/ns/source/registry> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """registry"""@en ; <https://app.safe-near.org/ns/rank> "5"^^xsd:integer .
<https://app.safe-near.org/ns/source/audit> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """audit"""@en ; <https://app.safe-near.org/ns/rank> "4"^^xsd:integer .
<https://app.safe-near.org/ns/source/trace> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """trace"""@en ; <https://app.safe-near.org/ns/rank> "3"^^xsd:integer .
<https://app.safe-near.org/ns/source/behaviour> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """behaviour"""@en ; <https://app.safe-near.org/ns/rank> "2"^^xsd:integer .
<https://app.safe-near.org/ns/source/name_pattern> a skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/source/> ; skos:prefLabel """name_pattern"""@en ; <https://app.safe-near.org/ns/rank> "1"^^xsd:integer .
