<https://app.safe-near.org/ns/> a owl:Ontology ;
  dcterms:title """Safe Near ontology of NEAR accounts"""@en ;
  dcterms:description """What an account is on NEAR (and the addresses on other chains that touch it): one class tree, the predicates that relate accounts, and the ranked sources of every statement. Generated from the code; see docs/ontology-layer-research.md."""@en ;
  owl:versionInfo "1" .
<https://app.safe-near.org/ns/class/> a skos:ConceptScheme ; dcterms:title """Classes of accounts"""@en .
<https://app.safe-near.org/ns/class/account> a owl:Class, skos:Concept ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """account"""@en ; skos:definition """Any account on NEAR, or an address on another chain."""@en .
<https://app.safe-near.org/ns/class/person> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:broader <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """person"""@en ; skos:definition """a person"""@en ; rdfs:seeAlso <https://followthemoney.tech/explorer/schemata/CryptoWallet/> .
<https://app.safe-near.org/ns/class/person/wallet> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/person> ; skos:broader <https://app.safe-near.org/ns/class/person> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """wallet"""@en ; skos:definition """a personal wallet"""@en ; skos:note """Open Labels Initiative tag is_eoa = true."""@en .
<https://app.safe-near.org/ns/class/person/smart_wallet> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/person> ; skos:broader <https://app.safe-near.org/ns/class/person> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """smart_wallet"""@en ; skos:definition """a smart wallet (an account contract)"""@en ; skos:note """Open Labels Initiative tag is_eoa = false (an account contract)."""@en .
<https://app.safe-near.org/ns/class/person/app_user> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/person> ; skos:broader <https://app.safe-near.org/ns/class/person> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """app_user"""@en ; skos:definition """a wallet-app user (a real person trading through an app)"""@en ; skos:note """Open Labels Initiative tag is_eoa = true."""@en .
<https://app.safe-near.org/ns/class/exchange> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:broader <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """exchange"""@en ; skos:definition """an exchange wallet"""@en ; rdfs:seeAlso <https://followthemoney.tech/explorer/schemata/CryptoWallet/> .
<https://app.safe-near.org/ns/class/exchange/hot_wallet> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/exchange> ; skos:broader <https://app.safe-near.org/ns/class/exchange> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """hot_wallet"""@en ; skos:definition """an exchange hot wallet"""@en .
<https://app.safe-near.org/ns/class/exchange/cold_wallet> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/exchange> ; skos:broader <https://app.safe-near.org/ns/class/exchange> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """cold_wallet"""@en ; skos:definition """an exchange cold wallet (its reserves)"""@en .
<https://app.safe-near.org/ns/class/exchange/deposit_address> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/exchange> ; skos:broader <https://app.safe-near.org/ns/class/exchange> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """deposit_address"""@en ; skos:definition """an exchange deposit address"""@en .
<https://app.safe-near.org/ns/class/service> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:broader <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """service"""@en ; skos:definition """a service"""@en .
<https://app.safe-near.org/ns/class/service/intents_solver> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """intents_solver"""@en ; skos:definition """a NEAR Intents solver (fills swaps for many users)"""@en .
<https://app.safe-near.org/ns/class/service/relayer> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """relayer"""@en ; skos:definition """a relayer (pays gas or creates accounts for users)"""@en .
<https://app.safe-near.org/ns/class/service/bridge> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """bridge"""@en ; skos:definition """a bridge to another chain"""@en .
<https://app.safe-near.org/ns/class/service/router> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """router"""@en ; skos:definition """a router (passes money through)"""@en .
<https://app.safe-near.org/ns/class/service/launchpad> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """launchpad"""@en ; skos:definition """a token launchpad"""@en .
<https://app.safe-near.org/ns/class/service/treasury_or_reward> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """treasury_or_reward"""@en ; skos:definition """a treasury or reward payer (pays many accounts)"""@en .
<https://app.safe-near.org/ns/class/service/factory> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/service> ; skos:broader <https://app.safe-near.org/ns/class/service> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """factory"""@en ; skos:definition """a factory (creates other contracts)"""@en .
<https://app.safe-near.org/ns/class/contract> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:broader <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """contract"""@en ; skos:definition """a contract"""@en ; skos:note """Open Labels Initiative tag is_eoa = false."""@en .
<https://app.safe-near.org/ns/class/contract/token> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """token"""@en ; skos:definition """a token contract"""@en .
<https://app.safe-near.org/ns/class/contract/nft> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """nft"""@en ; skos:definition """an NFT contract"""@en .
<https://app.safe-near.org/ns/class/contract/amm> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """amm"""@en ; skos:definition """a DEX / liquidity pool"""@en .
<https://app.safe-near.org/ns/class/contract/lending> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """lending"""@en ; skos:definition """a lending protocol"""@en .
<https://app.safe-near.org/ns/class/contract/vault_farm> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """vault_farm"""@en ; skos:definition """a farm or vault"""@en .
<https://app.safe-near.org/ns/class/contract/dao> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """dao"""@en ; skos:definition """a DAO"""@en .
<https://app.safe-near.org/ns/class/contract/multisig> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """multisig"""@en ; skos:definition """a multisig"""@en .
<https://app.safe-near.org/ns/class/contract/staking> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """staking"""@en ; skos:definition """a staking contract"""@en .
<https://app.safe-near.org/ns/class/contract/other> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/contract> ; skos:broader <https://app.safe-near.org/ns/class/contract> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """other"""@en ; skos:definition """a contract"""@en .
<https://app.safe-near.org/ns/class/system> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:broader <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """system"""@en ; skos:definition """a NEAR system account"""@en .
<https://app.safe-near.org/ns/class/unknown> a owl:Class, skos:Concept ; rdfs:subClassOf <https://app.safe-near.org/ns/class/account> ; skos:inScheme <https://app.safe-near.org/ns/class/> ; skos:prefLabel """unknown"""@en ; skos:definition """not classified yet (treated like a person)"""@en .
[] a owl:AllDisjointClasses ; owl:members ( <https://app.safe-near.org/ns/class/person> <https://app.safe-near.org/ns/class/exchange> <https://app.safe-near.org/ns/class/service> <https://app.safe-near.org/ns/class/contract> <https://app.safe-near.org/ns/class/system> ) .
<https://app.safe-near.org/ns/Fact> a owl:Class ; rdfs:label """Fact"""@en ; rdfs:comment """One statement about an account, with where it came from: its subject, predicate, object, ranked source, confidence, evidence, writer and the time it holds."""@en .
<https://app.safe-near.org/ns/pred/controls> a owl:ObjectProperty ; rdfs:label """controls"""@en ; rdfs:comment """The account controls another (an owner, DAO or multisig over a contract)."""@en .
<https://app.safe-near.org/ns/pred/created_by> a owl:ObjectProperty ; rdfs:label """created_by"""@en ; rdfs:comment """The account was created by another."""@en .
<https://app.safe-near.org/ns/pred/deployed> a owl:ObjectProperty ; rdfs:label """deployed"""@en ; rdfs:comment """The account deployed a contract."""@en .
<https://app.safe-near.org/ns/pred/flagged> a owl:DatatypeProperty ; rdfs:label """flagged"""@en ; rdfs:comment """The account is flagged, with a severity."""@en .
<https://app.safe-near.org/ns/pred/funded> a owl:ObjectProperty ; rdfs:label """funded"""@en ; rdfs:comment """The account paid another the money it started with."""@en .
<https://app.safe-near.org/ns/pred/is_a> a owl:ObjectProperty ; rdfs:label """is_a"""@en ; rdfs:comment """The class of the account (the class tree)."""@en .
<https://app.safe-near.org/ns/pred/label> a owl:DatatypeProperty ; rdfs:label """label"""@en ; rdfs:comment """A name for the account."""@en .
<https://app.safe-near.org/ns/pred/member_of> a owl:ObjectProperty ; rdfs:label """member_of"""@en ; rdfs:comment """The account belongs to a group of wallets with one owner."""@en .
<https://app.safe-near.org/ns/pred/operated_by> a owl:ObjectProperty ; rdfs:label """operated_by"""@en ; rdfs:comment """The organisation behind the account."""@en .
<https://app.safe-near.org/ns/pred/pass_through> a owl:DatatypeProperty ; rdfs:label """pass_through"""@en ; rdfs:comment """Money passes through the account; it never links owners."""@en .
<https://app.safe-near.org/ns/pred/role_in> a owl:ObjectProperty ; rdfs:label """role_in"""@en ; rdfs:comment """The account has a role in a case (attacker, victim, cash-out wallet ...)."""@en .
<https://app.safe-near.org/ns/pred/sent_to> a owl:ObjectProperty ; rdfs:label """sent_to"""@en ; rdfs:comment """A case sent money to an address on another chain."""@en .
<https://app.safe-near.org/ns/pred/solver_for> a owl:ObjectProperty ; rdfs:label """solver_for"""@en ; rdfs:comment """The account fills swaps for a service (a NEAR Intents solver)."""@en .
<https://app.safe-near.org/ns/pred/swept_to> a owl:ObjectProperty ; rdfs:label """swept_to"""@en ; rdfs:comment """The account sends its balance on to another (a hot wallet to its cold wallet)."""@en .
<https://app.safe-near.org/ns/pred/trusted> a owl:DatatypeProperty ; rdfs:label """trusted"""@en ; rdfs:comment """A dapp users interact with every day."""@en .
<https://app.safe-near.org/ns/subject> a owl:ObjectProperty ; rdfs:label """subject"""@en .
<https://app.safe-near.org/ns/predicate> a owl:ObjectProperty ; rdfs:label """predicate"""@en .
<https://app.safe-near.org/ns/object> a owl:ObjectProperty ; rdfs:label """object"""@en .
<https://app.safe-near.org/ns/source> a owl:ObjectProperty ; rdfs:label """source"""@en .
<https://app.safe-near.org/ns/confidence> a owl:DatatypeProperty ; rdfs:label """confidence"""@en .
<https://app.safe-near.org/ns/evidence> a owl:DatatypeProperty ; rdfs:label """evidence"""@en .
<https://app.safe-near.org/ns/by> a owl:DatatypeProperty ; rdfs:label """by"""@en .
<https://app.safe-near.org/ns/role> a owl:DatatypeProperty ; rdfs:label """role"""@en .
<https://app.safe-near.org/ns/status> a owl:DatatypeProperty ; rdfs:label """status"""@en .
<https://app.safe-near.org/ns/kind> a owl:DatatypeProperty ; rdfs:label """kind"""@en .
<https://app.safe-near.org/ns/validFrom> a owl:DatatypeProperty ; rdfs:label """validFrom"""@en .
<https://app.safe-near.org/ns/validTo> a owl:DatatypeProperty ; rdfs:label """validTo"""@en .
<https://app.safe-near.org/ns/rank> a owl:DatatypeProperty ; rdfs:label """rank"""@en .
